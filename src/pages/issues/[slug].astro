---
import { getIssues, getIssueContent, type Issue, type IssueContent } from '../../lib/buttondown';
import { issueTitle, issueHeading, metaDescription, newsArticleLd, breadcrumbLd, leadHeadline, absoluteUrl, storyUrl } from '../../lib/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryArticle from '../../components/StoryArticle.astro';
import SerialStrip from '../../components/SerialStrip.astro';
import Nav from '../../components/Nav.astro';
import SubscribeBlock from '../../components/SubscribeBlock.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  let issues: Issue[] = [];
  try {
    issues = await getIssues();
  } catch (e) {
    console.warn('[buttondown] API unavailable in getStaticPaths:', e);
    return [];
  }
  const latestNum = issues[0]?.number.toString().padStart(3, '0') ?? '-';
  // issues are sorted newest-first: i-1 is the newer issue, i+1 the older one.
  return issues.map((issue, i) => {
    const toRef = (it?: Issue) => (it ? { slug: it.slug, number: it.number } : null);
    return {
      params: { slug: issue.slug },
      props: {
        issue,
        latestIssueNumber: latestNum,
        newerIssue: toRef(issues[i - 1]),
        olderIssue: toRef(issues[i + 1]),
      },
    };
  });
}

interface IssueRef { slug: string; number: number; }
interface Props { issue: Issue; latestIssueNumber: string; newerIssue: IssueRef | null; olderIssue: IssueRef | null; }
const { issue, latestIssueNumber, newerIssue, olderIssue } = Astro.props;

let content: IssueContent = { introHtml: '', articles: [] };
try {
  content = await getIssueContent(issue.id);
} catch (e) {
  console.warn(`[buttondown] Could not fetch content for issue ${issue.slug}:`, e);
}

const numStr = issue.number.toString().padStart(3, '0');

const pageTitle = issueTitle(issue, content);
const pageDescription = metaDescription(issue, content);
const heading = issueHeading(issue, content);
const canonicalUrl = absoluteUrl(`/issues/${issue.slug}/`);
const jsonLd = [
  newsArticleLd({
    headline: leadHeadline(content) || issue.title || heading,
    description: pageDescription,
    datePublished: issue.publishedAt,
    url: canonicalUrl,
  }),
  breadcrumbLd([
    { name: 'Start', url: absoluteUrl('/') },
    { name: 'Wydania', url: absoluteUrl('/archiwum/') },
    { name: `Wydanie #${numStr}`, url: canonicalUrl },
  ]),
];
---

<BaseLayout title={pageTitle} description={pageDescription} ogType="article" jsonLd={jsonLd}>

  <SerialStrip latestIssueNumber={latestIssueNumber} />
  <Nav />

  <!-- Issue Masthead -->
  <header class="masthead">
    <div class="masthead-inner">
      <div class="masthead-bleed" aria-hidden="true">{numStr}</div>

      <div class="masthead-hero">
        <!-- Real, topical H1 for SEO; the stylized brand below is purely visual. -->
        <h1 class="sr-only">{heading}</h1>

        <div class="hero-top-meta">
          <span>Wydanie z poniedziałku &middot; {issue.dropDate}.{issue.year}</span>
        </div>

        <div class="hero-title" aria-hidden="true">
          PADEL<span class="slash">/</span>POLSKA
          <span class="weekly">Weekly.</span>
        </div>

        <div class="hero-sub">
          <span class="tag-mag">Newsletter &middot; Wydanie {numStr}</span>
          <span class="by">by <b>UrbanPadel</b></span>
        </div>

        <div class="data-rail">
          <div class="rail-cell">
            <div class="rail-k">Wydanie</div>
            <div class="rail-v">&#8470;&nbsp;{numStr}</div>
          </div>
          <div class="rail-cell">
            <div class="rail-k">Tydzień</div>
            <div class="rail-v acid">{issue.weekRange}</div>
          </div>
          <div class="rail-cell">
            <div class="rail-k">Rok</div>
            <div class="rail-v">{issue.year}</div>
          </div>
          <div class="rail-cell">
            <div class="rail-k">Data</div>
            <div class="rail-v">PON {issue.dropDate}</div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- B. INTRO - Editor's drop -->
  <section class="intro-section">
    <div class="intro-inner">
      <div class="cat-label"><span class="mg-arrow">&gt;&gt;</span> Editor's drop / intro</div>
      {content.introHtml
        ? <p class="intro-body" set:html={content.introHtml} />
        : issue.description
          ? <p class="intro-body">{issue.description}</p>
          : null
      }
    </div>
  </section>

  <!-- D + E. Articles -->
  {content.articles.length > 0 ? (
    <div class="articles">
      {content.articles.map((article) => (
        <StoryArticle article={article} as="h2" href={storyUrl(issue.slug, article)} />
      ))}
    </div>
  ) : (
    <div class="no-articles">
      <p>Treść tego wydania jest tymczasowo niedostępna.</p>
    </div>
  )}

  <!-- Inter-issue navigation -->
  {(olderIssue || newerIssue) && (
    <nav class="issue-nav" aria-label="Nawigacja między wydaniami">
      {olderIssue ? (
        <a class="issue-nav-link prev" href={`/issues/${olderIssue.slug}/`}>
          <span class="inl-dir">← Poprzednie wydanie</span>
          <span class="inl-num">#{olderIssue.number.toString().padStart(3, '0')}</span>
        </a>
      ) : <span class="issue-nav-spacer" />}
      <a class="issue-nav-link archive" href="/archiwum/">Całe archiwum</a>
      {newerIssue ? (
        <a class="issue-nav-link next" href={`/issues/${newerIssue.slug}/`}>
          <span class="inl-dir">Następne wydanie →</span>
          <span class="inl-num">#{newerIssue.number.toString().padStart(3, '0')}</span>
        </a>
      ) : <span class="issue-nav-spacer" />}
    </nav>
  )}

  <SubscribeBlock hidePerks />
  <Footer latestIssueNumber={numStr} />

  <button id="scrollTop" aria-label="Przewiń do góry" title="Przewiń do góry">
    ↑
  </button>

</BaseLayout>

<style>
  /* ── Masthead ──────────────────────────────────────────────────────────────── */
  .masthead {
    background: var(--bg);
    border-bottom: 2px solid var(--acid);
    overflow: hidden;
  }

  .masthead-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 32px 24px 28px;
    position: relative;
  }

  .masthead-bleed {
    position: absolute;
    top: -20px;
    right: -10px;
    font-family: 'Archivo Black', sans-serif;
    font-size: 320px;
    line-height: .8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--concrete);
    letter-spacing: -.05em;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .masthead-hero { position: relative; z-index: 2; }

  .hero-top-meta {
    font-family: 'VT323', monospace;
    font-size: 16px;
    color: var(--acid);
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(60px, 10vw, 108px);
    line-height: .88;
    letter-spacing: -.04em;
    margin: 0;
    color: var(--white);
    text-transform: uppercase;
  }

  .slash {
    color: var(--acid);
    display: inline-block;
    transform: skewX(-12deg);
    margin: 0 -.04em;
  }

  .weekly {
    display: block;
    color: var(--bg);
    background: var(--acid);
    padding: 2px 14px 6px;
    margin-top: 8px;
    width: max-content;
    max-width: 100%;
    transform: skewX(-8deg);
  }

  .hero-sub {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .tag-mag {
    background: var(--magenta);
    color: var(--white);
    font-family: 'Archivo Black', sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: .04em;
    padding: 5px 12px 6px;
    transform: rotate(-2deg);
  }

  .by {
    font-family: 'VT323', monospace;
    font-size: 17px;
    color: var(--fog);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .by b {
    color: var(--acid);
    text-decoration: underline;
    text-decoration-color: var(--magenta);
    text-underline-offset: 3px;
  }

  .data-rail {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--concrete);
    border-bottom: 1px solid var(--concrete);
  }

  .rail-cell {
    padding: 14px;
    border-right: 1px solid var(--concrete);
    font-family: 'VT323', monospace;
  }
  .rail-cell:last-child { border-right: none; }

  .rail-k {
    font-size: 13px;
    color: var(--fog);
    text-transform: uppercase;
    letter-spacing: .12em;
    margin-bottom: 2px;
  }

  .rail-v {
    font-family: 'Archivo Black', sans-serif;
    font-size: 18px;
    color: var(--white);
    letter-spacing: .01em;
  }
  .rail-v.acid { color: var(--acid); }

  /* ── B. Intro ──────────────────────────────────────────────────────────────── */
  .intro-section {
    background: var(--bg-2);
    border-bottom: 1px solid var(--concrete);
  }

  .intro-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 36px 24px;
  }

  .cat-label {
    font-family: 'VT323', monospace;
    font-size: 16px;
    color: var(--acid);
    text-transform: uppercase;
    letter-spacing: .1em;
    margin-bottom: 12px;
  }

  .mg-arrow { color: var(--magenta); }

  .intro-body {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 17px;
    line-height: 1.55;
    color: var(--chalk);
    max-width: 64ch;
    margin: 0;
  }

  .intro-body :global(strong) { color: var(--white); font-weight: 700; }
  .intro-body :global(span[style*="#d4ff3a"]) { background: var(--acid); color: var(--bg); padding: 0 4px; font-weight: 600; }
  .intro-body :global(span[style*="#ff2e6a"]) { color: var(--magenta); font-weight: 600; }

  /* ── D+E. Articles ─────────────────────────────────────────────────────────── */
  .articles { background: var(--bg); }

  /* ── Inter-issue navigation ──────────────────────────────────────────────── */
  .issue-nav {
    max-width: 980px;
    margin: 0 auto;
    padding: 32px 24px 48px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 14px;
    align-items: stretch;
  }

  .issue-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    border: 1px solid var(--concrete);
    padding: 14px 16px;
    font-family: 'VT323', monospace;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--chalk);
    transition: border-color .15s ease, color .15s ease;
  }

  .issue-nav-link:hover { border-color: var(--acid); color: var(--acid); }
  .issue-nav-link.next { text-align: right; align-items: flex-end; }
  .issue-nav-link.archive {
    justify-content: center;
    align-items: center;
    color: var(--acid);
    border-color: var(--acid);
  }
  .issue-nav-link.archive:hover { background: var(--acid); color: var(--bg); }

  .inl-dir { font-size: 16px; }
  .inl-num { font-family: 'Archivo Black', sans-serif; font-size: 15px; color: var(--white); }
  .issue-nav-link:hover .inl-num { color: var(--acid); }
  .issue-nav-spacer { display: block; }

  @media (max-width: 720px) {
    .issue-nav {
      grid-template-columns: 1fr;
      padding: 24px 16px 36px;
    }
    .issue-nav-link.next { text-align: left; align-items: flex-start; }
  }

  /* No-content fallback */
  .no-articles {
    max-width: 980px;
    margin: 0 auto;
    padding: 48px 24px;
    font-family: 'VT323', monospace;
    color: var(--fog);
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  /* ── Responsive ────────────────────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .masthead-inner  { padding: 24px 16px 22px; }
    .masthead-bleed  { font-size: 200px; right: -6px; }
    .hero-top-meta   { font-size: 14px; }
    .data-rail       { grid-template-columns: 1fr 1fr; }
    .rail-cell:nth-child(2) { border-right: none; }
    .rail-cell:nth-child(1),
    .rail-cell:nth-child(2) { border-bottom: 1px solid var(--concrete); }
    .intro-inner     { padding: 28px 16px; }
  }

  /* ── Scroll-to-top button ──────────────────────────────────────────────────── */
  #scrollTop {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 48px;
    height: 48px;
    background: var(--acid);
    color: var(--bg);
    border: none;
    font-family: 'Archivo Black', sans-serif;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity .2s, transform .2s;
    z-index: 999;
  }

  #scrollTop.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  #scrollTop:hover {
    background: var(--magenta);
    color: var(--white);
  }

  @media (max-width: 720px) {
    #scrollTop { bottom: 18px; right: 16px; }
  }
</style>

<script>
  (function () {
    const btn = document.getElementById('scrollTop');
    if (!btn) return;

    function onScroll() {
      const scrolled = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
      btn.classList.toggle('visible', scrolled >= 0.2);
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
