---
import type { Issue } from '../lib/buttondown';
import ArchivePaginator from './ArchivePaginator.astro';

interface Props {
  issueCount?: string;
  issues?: Issue[];
}
const { issueCount = '-', issues = [] } = Astro.props;
---

<section class="archive-section" id="archive">
  <div class="sechead">
    <span class="cat">★ Archiwum wydań</span>
    <span class="slash">// ostatnie drops</span>
  </div>

  <div class="archive">
    <div class="archive-toolbar">
      <div><span class="count">{issueCount}</span> wydań w archiwum · pokazujemy 8 ostatnich</div>
    </div>

    <ArchivePaginator issues={issues} />
  </div>
</section>

<style>
  .archive-section {
    background: var(--bg);
  }

  .sechead {
    max-width: 980px;
    margin: 0 auto;
    padding: 44px 24px 16px;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 20px;
    align-items: center;
  }

  .cat {
    background: var(--acid);
    color: var(--bg);
    font-family: 'Archivo Black', sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: .02em;
    padding: 6px 12px 7px;
    justify-self: start;
    align-self: center;
  }

  .slash {
    font-family: 'VT323', monospace;
    font-size: 16px;
    color: var(--fog);
    text-transform: uppercase;
    letter-spacing: .12em;
    justify-self: end;
    align-self: center;
    padding-left: 20px;
  }

  .archive {
    max-width: 980px;
    margin: 0 auto;
    padding: 10px 24px 96px;
  }

  .archive-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0 18px;
    border-bottom: 1px dashed var(--concrete);
    margin-bottom: 22px;
    font-family: 'VT323', monospace;
    font-size: 16px;
    color: var(--fog);
    text-transform: uppercase;
    letter-spacing: .08em;
    flex-wrap: wrap;
    gap: 12px;
  }

  .count {
    color: var(--acid);
  }

  @media (max-width: 720px) {
    .sechead {
      padding: 36px 16px 14px;
      column-gap: 14px;
    }

    .slash {
      padding-left: 8px;
      font-size: 16px;
    }

    .archive {
      padding: 6px 16px 64px;
    }

  }
</style>
